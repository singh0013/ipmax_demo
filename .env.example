# Database
POSTGRES_DB=ipam
POSTGRES_USER=ipam_user
POSTGRES_PASSWORD=change-this-password

# App
SECRET_KEY=change-this-secret-key-in-production

# Port (default: 80)
# For AlgoSec (443 already taken by httpd):
#   1. systemctl stop httpd
#   2. Set IPAM_PORT=443
# For Skybox UI conflict:
#   Set IPAM_PORT=8080
IPAM_PORT=80
